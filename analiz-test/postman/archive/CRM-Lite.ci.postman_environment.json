{
  "id": "crm-lite-env-ci",
  "name": "CRM Lite — CI / Newman",
  "values": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "default",
      "enabled": true,
      "description": "CI'da --env-var \"baseUrl=...\" ile ezilir."
    },
    {
      "key": "username",
      "value": "salesperson",
      "type": "default",
      "enabled": true
    },
    {
      "key": "password",
      "value": "",
      "type": "secret",
      "enabled": true,
      "description": "Bilincli olarak bos. CI kosumunda --env-var \"password=$CRM_TEST_PASSWORD\" ile verilir."
    },
    {
      "key": "strictMode",
      "value": "false",
      "type": "default",
      "enabled": true,
      "description": "Bilinen bosluklar kapatildikca true yapilir; o andan itibaren regresyon korumasi tam olur."
    },
    {
      "key": "cleanup",
      "value": "true",
      "type": "default",
      "enabled": true
    },
    {
      "key": "abortOnSmokeFailure",
      "value": "true",
      "type": "default",
      "enabled": true
    },
    {
      "key": "maxResponseTimeMs",
      "value": "5000",
      "type": "default",
      "enabled": true,
      "description": "CI makineleri lokalden yavas olabilir; esik bilincli olarak daha genis."
    },
    {
      "key": "corsOrigin",
      "value": "http://localhost:4200",
      "type": "default",
      "enabled": true
    },
    {
      "key": "defaultCityId",
      "value": "201",
      "type": "default",
      "enabled": true
    },
    {
      "key": "defaultGenderId",
      "value": "1",
      "type": "default",
      "enabled": true
    },
    {
      "key": "prodOfrId",
      "value": "",
      "type": "default",
      "enabled": true
    },
    {
      "key": "runSlowTests",
      "value": "false",
      "type": "default",
      "enabled": true
    },
    {
      "key": "shortTokenWaitSeconds",
      "value": "35",
      "type": "default",
      "enabled": true
    },
    {
      "key": "lockoutTestEnabled",
      "value": "false",
      "type": "default",
      "enabled": true,
      "description": "CI'da her zaman false kalmalidir - kullaniciyi kilitleyip sonraki kosumlari bozar."
    }
  ],
  "_postman_variable_scope": "environment",
  "_postman_exported_using": "CRM Lite analiz-test"
