<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Regression suite — FR-001..FR-012'nin tamami.
  Calistirma: ./mvnw test -Dsuite=regression

  "documented-gap" grubu suite duzeyinde DISLANIR. O gruptaki testler dokumana gore
  yazilmis ve uygulamada karsiligi olmadigi icin bilerek kirmizi birakilmistir; burada
  kosarsa regresyon hicbir zaman yesile donmez ve gercek regresyonlari gorunmez kilar.
  Bu testler kendi FR suite'lerinde (orn. fr008.xml) kosulmaya devam eder - kapsam
  disina cikarilmis degil, yalnizca gecer/kalir kapisindan ayrilmislardir.

  parallel="classes" bilincli secildi: paralellik sinif duzeyinde kalirsa her
  sinif kendi test verisiyle calisir ve veri yarisi (race) olusmaz. WebDriver
  ThreadLocal'da tutuldugu icin her is parcacigi kendi tarayicisini kullanir.

  !! DOGRULANMADI: Suite'ler bugune kadar hep tek tek (fr001..fr005, parallel=false)
  calistirildi; paralel kosum henuz ucdan uca dogrulanmadi. CI'a alinmadan once
  bir kez calistirilip iki nokta gozlenmelidir:
    1) 3 es zamanli Chrome + backend yuku altinda renderer timeout artiyor mu,
    2) NationalIdUniquenessTests gibi tekillik senaryolari birbirinin verisini
       goruyor mu (TestRunId + sequence bunu onlemeli, ama kanit yok).
  Sorun cikarsa once thread-count=2, sonra parallel="false" ile denenmelidir.

  FR-001 dahildir: kullanicinin talimatiyla uzerinde calisilmiyor ve tamamlanmis
  kabul ediliyor. Riskli iki senaryo zaten disarida: AccountLockTests karantinada
  (quarantine.xml, -DlockoutTestEnabled=true), logout testleri enabled=false.
-->
<!-- configfailurepolicy=continue: tek bir @BeforeMethod hatasi, sinifin geri kalan
     testlerinin config metotlarinin da atlanmasina (ciglama) yol acmamalidir. -->
<suite name="CRM Lite UI - Regression" verbose="1" parallel="classes" configfailurepolicy="continue" thread-count="3">

    <listeners>
        <listener class-name="com.crmlite.ui.core.listeners.SuiteListener"/>
        <listener class-name="com.crmlite.ui.core.listeners.TestListener"/>
        <listener class-name="com.crmlite.ui.core.listeners.RetryAnnotationTransformer"/>
    </listeners>

    <groups>
        <run>
            <exclude name="documented-gap"/>
        </run>
    </groups>

    <test name="Cerceve Self-Check">
        <classes>
            <class name="com.crmlite.ui.tests.SmokeSelfCheckTest"/>
            <class name="com.crmlite.ui.tests.LocatorSanityTest"/>
            <class name="com.crmlite.ui.tests.DataLayerSelfCheckTest"/>
        </classes>
    </test>

    <test name="FR-001 Sistem Girisi">
        <classes>
            <class name="com.crmlite.ui.tests.fr001login.LoginTests"/>
            <class name="com.crmlite.ui.tests.fr001login.LoginValidationTests"/>
            <class name="com.crmlite.ui.tests.fr001login.SessionTests"/>
        </classes>
    </test>

    <test name="FR-002 Musteri Arama">
        <classes>
            <class name="com.crmlite.ui.tests.fr002search.CustomerSearchTests"/>
            <class name="com.crmlite.ui.tests.fr002search.SearchFilterValidationTests"/>
            <class name="com.crmlite.ui.tests.fr002search.SearchPaginationSortTests"/>
        </classes>
    </test>

    <test name="FR-003 Musteri Olusturma">
        <classes>
            <class name="com.crmlite.ui.tests.fr003create.CreateCustomerHappyPathTests"/>
            <class name="com.crmlite.ui.tests.fr003create.CreateCustomerValidationTests"/>
            <class name="com.crmlite.ui.tests.fr003create.NationalIdUniquenessTests"/>
        </classes>
    </test>

    <test name="FR-004 Musteri Guncelleme">
        <classes>
            <class name="com.crmlite.ui.tests.fr004update.UpdateCustomerTests"/>
            <class name="com.crmlite.ui.tests.fr004update.UpdateValidationTests"/>
        </classes>
    </test>

    <test name="FR-005 Adres Yonetimi">
        <classes>
            <class name="com.crmlite.ui.tests.fr005address.AddressCrudTests"/>
            <class name="com.crmlite.ui.tests.fr005address.PrimaryAddressTests"/>
            <class name="com.crmlite.ui.tests.fr005address.AddressLimitTests"/>
        </classes>
    </test>

    <!--
      ContactCancelConfirmationTests bilincli olarak disarida: ACC-006'nin sart kostugu
      onay mesaji uygulamada yok ve test dokumana gore yazildi. Regresyon suite'inin
      yesil kalmasi icin yalnizca fr006.xml uzerinden kosulur.
    -->
    <test name="FR-006 Iletisim Bilgileri Yonetimi">
        <classes>
            <class name="com.crmlite.ui.tests.fr006contact.ContactMediumTests"/>
            <class name="com.crmlite.ui.tests.fr006contact.ContactMediumValidationTests"/>
        </classes>
    </test>

    <test name="FR-007 Musteri Silme">
        <classes>
            <class name="com.crmlite.ui.tests.fr007delete.DeleteCustomerTests"/>
        </classes>
    </test>

    <!--
      BillingAccountCancelTests bilincli olarak disarida: ACC-006/ACC-010 uyari adimlari
      uygulamada yok ve modal tasmasi (FR-008-BUG-MODAL-OVERFLOW) gercek bir urun hatasi.
      BillingAccountValidationTests dahildir; icindeki tek kirmizi
      (createIsDisabledWithoutAccountDescription, FR-008-GAP-ACC009) yukaridaki
      documented-gap dislamasiyla otomatik olarak elenir.
    -->
    <test name="FR-008 Fatura Hesabi Olusturma">
        <classes>
            <class name="com.crmlite.ui.tests.fr008account.CreateBillingAccountTests"/>
            <class name="com.crmlite.ui.tests.fr008account.BillingAccountValidationTests"/>
        </classes>
    </test>

    <test name="FR-009 Fatura Hesabi ve Bagli Urun Goruntuleme">
        <classes>
            <class name="com.crmlite.ui.tests.fr009accountproduct.AccountProductViewTests"/>
            <class name="com.crmlite.ui.tests.fr009accountproduct.AccountPaginationAndGapTests"/>
        </classes>
    </test>

    <test name="FR-010 Fatura Hesabi Guncelleme">
        <classes>
            <class name="com.crmlite.ui.tests.fr010accountupdate.UpdateBillingAccountTests"/>
        </classes>
    </test>

    <test name="FR-011 Fatura Hesabi Silme">
        <classes>
            <class name="com.crmlite.ui.tests.fr011accountdelete.DeleteBillingAccountTests"/>
        </classes>
    </test>

    <!--
      FR-012 ON KOSUL: product-service ve order-service ayakta olmalidir - Offer Selection
      ekrani katalog/kampanya verisini bu servislerden ceker.
    -->
    <test name="FR-012 Yeni Satis Surecini Baslatma">
        <classes>
            <class name="com.crmlite.ui.tests.fr012newsale.StartNewSaleTests"/>
        </classes>
    </test>

</suite>
