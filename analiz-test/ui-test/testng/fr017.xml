<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  FR-017 Siparisi Tamamlama.
  Calistirma: ./mvnw test -Dsuite=fr017

  Kriterler UC-EACRML-016 basliginin altindadir. ACC-002 testi documented-gap: dokuman submit onayi ister, uygulamada boyle bir onay YOK. DIKKAT: bu suite GERCEK SIPARIS olusturur.
-->
<suite name="CRM Lite UI - FR017" verbose="1" parallel="false" configfailurepolicy="continue">

    <listeners>
        <listener class-name="com.crmlite.ui.core.listeners.SuiteListener"/>
        <listener class-name="com.crmlite.ui.core.listeners.TestListener"/>
        <listener class-name="com.crmlite.ui.core.listeners.RetryAnnotationTransformer"/>
    </listeners>

    <test name="FR-017 Siparisi Tamamlama">
        <classes>
            <class name="com.crmlite.ui.tests.fr017submit.SubmitOrderTests"/>
        </classes>
    </test>

</suite>
