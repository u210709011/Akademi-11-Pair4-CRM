<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  FR-008 Yeni Musteri Fatura Hesabi Olusturma (UC-EACRML-008).
  Calistirma: ./mvnw test -Dsuite=fr008

  BillingAccountCancelTests ve BillingAccountValidationTests'teki
  createIsDisabledWithoutAccountDescription bilincli olarak KIRMIZI kalir:
    - ACC-006 / ACC-010: Cancel uyari adimi uygulamada yok
    - ACC-009: Account Description dokumanda zorunlu, uygulamada opsiyonel
  Testler dokumana gore yazildi; uyumsuzluk gorunur kalsin diye devre disi birakilmadi.
  CI'da haric tutulmasi gerekirse "documented-gap" grubu dislanabilir.
-->
<!-- configfailurepolicy=continue: tek bir @BeforeMethod hatasi, sinifin geri kalan
     testlerinin config metotlarinin da atlanmasina yol acmamalidir. -->
<suite name="CRM Lite UI - FR-008" verbose="1" parallel="false" configfailurepolicy="continue">

    <listeners>
        <listener class-name="com.crmlite.ui.core.listeners.SuiteListener"/>
        <listener class-name="com.crmlite.ui.core.listeners.TestListener"/>
        <listener class-name="com.crmlite.ui.core.listeners.RetryAnnotationTransformer"/>
    </listeners>

    <test name="FR-008 Fatura Hesabi Olusturma">
        <classes>
            <class name="com.crmlite.ui.tests.fr008account.CreateBillingAccountTests"/>
            <class name="com.crmlite.ui.tests.fr008account.BillingAccountValidationTests"/>
            <class name="com.crmlite.ui.tests.fr008account.BillingAccountCancelTests"/>
        </classes>
    </test>

</suite>
