<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  FR-016 Siparis Ozeti Goruntuleme.
  Calistirma: ./mvnw test -Dsuite=fr016

  Kriterler UC-EACRML-015 basliginin altindadir. Review adimina ulasmak sepette urun + servis adresi + zorunlu karakteristikler gerektirir; saglanamazsa testler ATLANIR.
-->
<suite name="CRM Lite UI - FR016" verbose="1" parallel="false" configfailurepolicy="continue">

    <listeners>
        <listener class-name="com.crmlite.ui.core.listeners.SuiteListener"/>
        <listener class-name="com.crmlite.ui.core.listeners.TestListener"/>
        <listener class-name="com.crmlite.ui.core.listeners.RetryAnnotationTransformer"/>
    </listeners>

    <test name="FR-016 Siparis Ozeti Goruntuleme">
        <classes>
            <class name="com.crmlite.ui.tests.fr016review.OrderSummaryTests"/>
        </classes>
    </test>

</suite>
