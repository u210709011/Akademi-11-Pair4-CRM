<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  FR-010 Billing Account Guncelleme (UC-EACRML-010).
  Calistirma: ./mvnw test -Dsuite=fr010

  Uygulama guncelleme icin ayri bir ekran acmaz; olusturma modalinin aynisini kullanir
  (baslik editingAccount() degerine gore degisir). Bu yuzden FR-008'de bulunan modal
  tasmasi guncelleme akisi icin de gecerlidir: yeni adres moduna gecildiginde
  Save/Cancel butonlari goruntulenen alanin disinda kalabilir.
-->
<!-- configfailurepolicy=continue: tek bir @BeforeMethod hatasi, sinifin geri kalan
     testlerinin config metotlarinin da atlanmasina yol acmamalidir. -->
<suite name="CRM Lite UI - FR-010" verbose="1" parallel="false" configfailurepolicy="continue">

    <listeners>
        <listener class-name="com.crmlite.ui.core.listeners.SuiteListener"/>
        <listener class-name="com.crmlite.ui.core.listeners.TestListener"/>
        <listener class-name="com.crmlite.ui.core.listeners.RetryAnnotationTransformer"/>
    </listeners>

    <test name="FR-010 Billing Account Guncelleme">
        <classes>
            <class name="com.crmlite.ui.tests.fr010accountupdate.UpdateBillingAccountTests"/>
        </classes>
    </test>

</suite>
