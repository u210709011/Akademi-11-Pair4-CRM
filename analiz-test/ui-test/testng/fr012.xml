<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  FR-012 Yeni Satis Surecini Baslatma (UC-EACRML-012).
  Calistirma: ./mvnw test -Dsuite=fr012

  ON KOSUL: product-service ve order-service ayakta olmalidir - Offer Selection ekrani
  acilirken katalog/kampanya verisini bu servislerden ceker.

  Giris noktasi hesap satirinin ICINDEDIR: "Start New Sale" butonu ancak satir
  genisletildiginde gorunur.
-->
<!-- configfailurepolicy=continue: tek bir @BeforeMethod hatasi, sinifin geri kalan
     testlerinin config metotlarinin da atlanmasina yol acmamalidir. -->
<suite name="CRM Lite UI - FR-012" verbose="1" parallel="false" configfailurepolicy="continue">

    <listeners>
        <listener class-name="com.crmlite.ui.core.listeners.SuiteListener"/>
        <listener class-name="com.crmlite.ui.core.listeners.TestListener"/>
        <listener class-name="com.crmlite.ui.core.listeners.RetryAnnotationTransformer"/>
    </listeners>

    <test name="FR-012 Yeni Satis Surecini Baslatma">
        <classes>
            <class name="com.crmlite.ui.tests.fr012newsale.StartNewSaleTests"/>
        </classes>
    </test>

</suite>
