<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  FR-018 Dil Destegi.
  Calistirma: ./mvnw test -Dsuite=fr018

  Kriterler UC-EACRML-017 basliginin altindadir. Dil localStorage'da kalici oldugu icin her test sonunda EN'e geri alinir. ACC-002 testi documented-gap: dokuman varsayilani Turkce ister, uygulama Ingilizce aciliyor.
-->
<suite name="CRM Lite UI - FR018" verbose="1" parallel="false" configfailurepolicy="continue">

    <listeners>
        <listener class-name="com.crmlite.ui.core.listeners.SuiteListener"/>
        <listener class-name="com.crmlite.ui.core.listeners.TestListener"/>
        <listener class-name="com.crmlite.ui.core.listeners.RetryAnnotationTransformer"/>
    </listeners>

    <test name="FR-018 Dil Destegi">
        <classes>
            <class name="com.crmlite.ui.tests.fr018language.LanguageSupportTests"/>
        </classes>
    </test>

</suite>
