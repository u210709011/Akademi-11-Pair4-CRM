<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Tek test kosmak icin suite - demo/sunum ve kararsiz bir testi hizlica siniflandirmak
  icin kullanilir.

  KOSUM: ./demo.sh                    (onerilen - Maven'i atlar, ~49 sn)
         ./mvnw test -Dsuite=single   (ayni test, ~100 sn - Maven'in kendi acilisi
                                       tek basina ~41 sn tutuyor)

  Su an secili: E2E uctan uca kullanici yolculugu.
  Bir satis temsilcisinin gunluk isinin TAMAMI ekranda yurutulur: gercek login
  ekranindan giris, yeni musteri olusturma (adres + iletisim), fatura hesabi acma,
  o hesaptan satis baslatma, katalogdan urun secme, konfigurasyon, ozet, Submit
  onayi ve son olarak siparisin fatura hesabinda GORUNDUGUNUN dogrulanmasi.
  Hicbir adimda API kullanilmaz.

  ALTERNATIF - yalnizca satis akisi (~40 sn):
    <class name="com.crmlite.ui.tests.fr017submit.SubmitOrderTests">
        <methods><include name="submitSendsOrderAndShowsSuccessMessage"/></methods>
    </class>
  Daha kisadir ANCAK oturumu token enjekte ederek acar: ekranda login sayfasi kisa
  sure gorunur ve kimse bir sey yazmadan iceri gecilir. Sunumda "giris nasil yapildi"
  sorusunu davet ettigi icin demo olarak E2E tercih edildi. Sure farki ~9 saniyedir.

  ON KOSUL: tum servisler + frontend ayakta olmalidir.
  NOT: bu test GERCEK MUSTERI ve GERCEK SIPARIS olusturur.
  NOT: soguk baslangicta ilk kosum belirgin sekilde yavastir (JIT + bos lookup
  onbellekleri). SUNUMDAN ONCE bir kez isitma kosumu yapilmalidir.
-->
<suite name="CRM Lite UI - Tek Test" verbose="1" parallel="false" configfailurepolicy="continue">

    <listeners>
        <listener class-name="com.crmlite.ui.core.listeners.SuiteListener"/>
        <listener class-name="com.crmlite.ui.core.listeners.TestListener"/>
        <listener class-name="com.crmlite.ui.core.listeners.RetryAnnotationTransformer"/>
    </listeners>

    <test name="Tek Test">
        <classes>
            <class name="com.crmlite.ui.tests.demo.LoginAndCreateCustomerDemo"/>
        </classes>
    </test>

</suite>
