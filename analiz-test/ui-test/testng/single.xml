<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Tek test kosmak icin gecici suite - kararsiz (flaky) bir testi hizlica siniflandirmak
  amaciyla kullanilir. Tum suite'i kosmak yerine yalnizca supheli testi kosar.

  Kullanim: sinif ve metot adini asagida degistir, sonra:
      ./mvnw test -Dsuite=single
-->
<suite name="CRM Lite UI - Tek Test" verbose="1" parallel="false" configfailurepolicy="continue">

    <listeners>
        <listener class-name="com.crmlite.ui.core.listeners.SuiteListener"/>
        <listener class-name="com.crmlite.ui.core.listeners.TestListener"/>
        <listener class-name="com.crmlite.ui.core.listeners.RetryAnnotationTransformer"/>
    </listeners>

    <test name="Tek Test">
        <classes>
            <class name="com.crmlite.ui.tests.fr002search.CustomerSearchTests">
                <methods>
                    <include name="firstAndLastNameUseAndLogic"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
