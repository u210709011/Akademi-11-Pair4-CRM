<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Tek test kosmak icin suite - demo/sunum ve kararsiz bir testi hizlica siniflandirmak
  icin kullanilir. Tum suite'i kosmak yerine yalnizca secilen testi kosar.

  Kullanim: ./mvnw test -Dsuite=single
  Baska bir testi kosmak icin asagidaki sinif ve metot adini degistirmek yeterlidir.

  Su an secili: E2E uctan uca kullanici yolculugu (~19 sn).
  Bir satis temsilcisinin gunluk isinin TAMAMI arayuzden yurutulur: sisteme giris,
  yeni musteri olusturma (adres + iletisim), fatura hesabi acma, o hesap uzerinden
  satis, katalogdan urun secme, konfigurasyon, ozet, Submit onayi ve son olarak
  siparisin fatura hesabinda GORUNDUGUNUN dogrulanmasi. Hicbir adimda API kullanilmaz.

  ONCEKI SECIM (geri almak icin asagidaki <class> blogunu bununla degistir):
    <class name="com.crmlite.ui.tests.fr017submit.SubmitOrderTests">
        <methods><include name="submitSendsOrderAndShowsSuccessMessage"/></methods>
    </class>
  Fark: FR-017 testi satis sihirbazinin ORTASINDAN baslar, musteri ve fatura hesabi
  API ile hazirlanir. E2E ise sifirdan baslar ve onun kapsadigi her adimi da icerir.

  ON KOSUL: tum servisler + frontend ayakta olmalidir.
  NOT: bu test GERCEK MUSTERI ve GERCEK SIPARIS olusturur.
  NOT: soguk baslangicta Selenium Manager surucu listesini indirmeye calisip ~4,5 dk
  takilabiliyor. SUNUMDAN ONCE bir kez isitma kosumu yapilmalidir.
-->
<suite name="CRM Lite UI - Tek Test" verbose="1" parallel="false" configfailurepolicy="continue">

    <listeners>
        <listener class-name="com.crmlite.ui.core.listeners.SuiteListener"/>
        <listener class-name="com.crmlite.ui.core.listeners.TestListener"/>
        <listener class-name="com.crmlite.ui.core.listeners.RetryAnnotationTransformer"/>
    </listeners>

    <test name="Tek Test">
        <classes>
            <class name="com.crmlite.ui.tests.e2e.CustomerToOrderJourneyTest"/>
        </classes>
    </test>

</suite>
