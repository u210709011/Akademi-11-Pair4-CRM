<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  FR-007 Musteri Silme (UC-EACRML-007).
  Calistirma: ./mvnw test -Dsuite=fr007

  DeleteCustomerLinkedProductTests (ACC-004) enabled=false ile kapalidir: kural silme
  akisinda hic cagrilmiyor ve on kosulu (pasif hesap + bagli urun) mevcut UI ile
  kurulamiyor. FR-010 implemente edildiginde aktiflestirilmelidir.

  NOT: Bu suite VERI SILER. Her test kendi musterisini kurar, ancak basarili silme
  testi geri alinamaz - paylasilan veri uzerinde calistirilmamalidir.
-->
<!-- configfailurepolicy=continue: tek bir @BeforeMethod hatasi, sinifin geri kalan
     testlerinin config metotlarinin da atlanmasina yol acmamalidir. -->
<suite name="CRM Lite UI - FR-007" verbose="1" parallel="false" configfailurepolicy="continue">

    <listeners>
        <listener class-name="com.crmlite.ui.core.listeners.SuiteListener"/>
        <listener class-name="com.crmlite.ui.core.listeners.TestListener"/>
        <listener class-name="com.crmlite.ui.core.listeners.RetryAnnotationTransformer"/>
    </listeners>

    <test name="FR-007 Musteri Silme">
        <classes>
            <class name="com.crmlite.ui.tests.fr007delete.DeleteCustomerTests"/>
            <class name="com.crmlite.ui.tests.fr007delete.DeleteCustomerLinkedProductTests"/>
        </classes>
    </test>

</suite>
