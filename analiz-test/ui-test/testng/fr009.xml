<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  FR-009 Fatura Hesabi ve Bagli Urun Goruntuleme (UC-EACRML-009).
  Calistirma: ./mvnw test -Dsuite=fr009

  ON KOSUL: order-service ve product-service AYAKTA olmalidir. Urun gerektiren
  senaryolar dort adimli siparis akisini isletir (bkz. OrderApi); servisler kapaliysa
  testler kirmizi degil, "on kosul kurulamadi" hatasiyla duser.
  OrderApiSelfCheckTest bunu suite'in basinda erken yakalar.

  BILINCLI KIRMIZI: AccountPaginationAndGapTests.emptyStateMessageIsShownWhenNoBillingAccounts
  ACC-001'in sart kostugu bos durum mesaji uygulamada yok; test dokumana gore yazildi ve
  "documented-gap" grubunda. CI'da bu grup dislanabilir.
-->
<!-- configfailurepolicy=continue: tek bir @BeforeMethod hatasi, sinifin geri kalan
     testlerinin config metotlarinin da atlanmasina yol acmamalidir. -->
<suite name="CRM Lite UI - FR-009" verbose="1" parallel="false" configfailurepolicy="continue">

    <listeners>
        <listener class-name="com.crmlite.ui.core.listeners.SuiteListener"/>
        <listener class-name="com.crmlite.ui.core.listeners.TestListener"/>
        <listener class-name="com.crmlite.ui.core.listeners.RetryAnnotationTransformer"/>
    </listeners>

    <test name="On Kosul Self-Check">
        <classes>
            <class name="com.crmlite.ui.tests.OrderApiSelfCheckTest"/>
        </classes>
    </test>

    <test name="FR-009 Hesap ve Bagli Urun Goruntuleme">
        <classes>
            <class name="com.crmlite.ui.tests.fr009accountproduct.AccountProductViewTests"/>
            <class name="com.crmlite.ui.tests.fr009accountproduct.AccountPaginationAndGapTests"/>
        </classes>
    </test>

</suite>
